# Telegram
TELEGRAM_TOKEN=123456:ABC-токен-от-BotFather
# Сотрудники, которым доступен бот, и администраторы (команда /status) — ID через запятую
ALLOWED_USER_IDS=111111111,222222222
ADMIN_USER_IDS=111111111

# Google Sheets (сервисный аккаунт с доступом к таблице); пусто — выгрузка в таблицу выключена
SPREADSHEET_ID=
GOOGLE_CREDENTIALS_PATH=credentials.json
WORKSHEET_NAME=Отчёт аптек
PRIORITY_WORKSHEET_NAME=Приоритет

# Яндекс Диск (OAuth-токен); пусто — кнопка «Взять с Я.Диска» выключена
YANDEX_OAUTH_TOKEN=
YANDEX_STOCK_DIR=disk:/Отчёты аптек/остатки/
YANDEX_EXPIRY_DIR=disk:/Отчёты аптек/сроки/

# Правила отчётов
ILLIQUID_DAYS=90
ILLIQUID_MIN_SUM=3000
EXPIRY_DAYS=30

# Ежедневный отчёт по расписанию: свежие файлы с Я.Диска → сообщение в чат
DAILY_REPORT_TIME=09:00
REPORT_CHAT_ID=
TIMEZONE=Europe/Moscow

DATA_DIR=data
